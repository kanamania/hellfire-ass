<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds trust system CAs only. Debuggable builds also trust CAs the owner installed
     (Settings > Security > Encryption & credentials), so the phone can reach the self-signed
     https://hellfire.local web copy and relays during device testing. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors><certificates src="user" /></trust-anchors>
    </debug-overrides>
</network-security-config>
